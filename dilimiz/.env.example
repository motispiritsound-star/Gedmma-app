# Welke omgeving dit is: dev | test | prod. Leeg betekent prod.
#
# `test` zet alle lessen open en bootst de winkel na, zodat de betaalstroom
# te doorlopen is zonder echte aankoop. Alleen src/engine/omgeving.ts leest
# deze waarde — zo is op één plek te zien wat per omgeving verschilt.
VITE_OMGEVING=dev
