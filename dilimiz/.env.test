# Gelezen door `vite build --mode test`, voor de koop-rooktest.
#
# `test` laat src/engine/omgeving.ts de nagebootste winkel kiezen, zodat de
# koopstroom te doorlopen is zonder telefoon en zonder echte afschrijving.
#
# Hier staat geen geheim in en dat hoort ook niet: dit bestand gaat mee in git,
# zodat `npm run rook-koop` het op elke computer doet. Een testbouw belandt in
# dist-test/ en nooit in dist/, zodat hij niet per ongeluk geüpload wordt.
VITE_OMGEVING=test
