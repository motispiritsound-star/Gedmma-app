# Geen echte waarden in dit bestand. Kopieer naar .env en vul daar in.
# Secrets staan nooit in de database en nooit in logs.

# --- Modus ------------------------------------------------------------------
# true  = privé uploaden en wachten op menselijke goedkeuring (standaard)
# false = automatisch publiceren, behalve bij gevoelige onderwerpen en bij
#         middel of hoog beleidsrisico; die wachten altijd
APPROVAL_MODE=true

# Zet alle wachtrijen stil en blokkeert elke publicatie. Werkt ook via de CLI,
# zodat hij het doet als het dashboard stuk is.
KILL_SWITCH=false

# --- Opslag -----------------------------------------------------------------
DATABASE_URL=postgresql://user:wachtwoord@localhost:5432/yge
REDIS_URL=redis://localhost:6379

# S3-compatibel. Cloudflare R2 of Backblaze B2: geen egress-kosten.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Taalmodel --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- YouTube ----------------------------------------------------------------
# Minimale scopes: youtube.upload en yt-analytics.readonly. Meer niet —
# automatische engagement is daarmee technisch onmogelijk.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4400/oauth/callback
YOUTUBE_CHANNEL_ID=

# --- Productieproviders -----------------------------------------------------
TTS_PROVIDER=mock
TTS_API_KEY=

IMAGE_PROVIDER=mock
IMAGE_API_KEY=

VIDEO_CLIP_PROVIDER=mock
VIDEO_CLIP_API_KEY=

MUSIC_PROVIDER=mock
MUSIC_API_KEY=

# ffmpeg-local is ook de productierenderer; shotstack is de reserveadapter.
RENDER_PROVIDER=ffmpeg-local
RENDER_API_KEY=

# --- Kostenplafonds (in eurocent) -------------------------------------------
# Bij overschrijding pauzeert de wachtrij. Geen stille doorbelasting.
BUDGET_PER_PRODUCTION_CENTS=1800
BUDGET_PER_DAY_CENTS=800
BUDGET_PER_MONTH_CENTS=10000

# --- Meldingen --------------------------------------------------------------
ALERT_WEBHOOK_URL=
