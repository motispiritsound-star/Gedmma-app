{
  "name": "youtube-growth-engine",
  "private": true,
  "version": "0.1.0",
  "description": "Redactionele productiepipeline voor een YouTube-kanaal, met kwaliteitspoorten die publicatie kunnen tegenhouden",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx --import ./src/lib/env.ts src/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx --import ./src/lib/env.ts src/doctor.ts",
    "youtube:connect": "tsx --import ./src/lib/env.ts src/connect-youtube.ts",
    "produce": "tsx --import ./src/lib/env.ts src/produce.ts",
    "upload": "tsx --import ./src/lib/env.ts src/upload.ts",
    "studio": "tsx --import ./src/lib/env.ts src/studio.ts",
    "knowledge:check": "tsx --import ./src/lib/env.ts src/knowledge-check.ts",
    "workbook": "tsx --import ./src/lib/env.ts src/workbook.ts",
    "approve": "tsx --import ./src/lib/env.ts src/approve.ts",
    "niches": "tsx --import ./src/lib/env.ts src/compare-niches.ts",
    "animatic": "tsx --import ./src/lib/env.ts src/animatic.ts",
    "stijlvoorbeeld": "node scripts/stijlvoorbeeld/build.mjs",
    "release": "tsx --import ./src/lib/env.ts src/release.ts",
    "lengte": "tsx --import ./src/lib/env.ts src/lengte.ts",
    "google:env": "tsx --import ./src/lib/env.ts src/setup-google.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "yaml": "^2.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
