# Apache-hosting (mijndomein, Strato, een eigen VPS): dit is een single-page
# app, dus /leren en /privacy bestaan niet als bestand. Zonder deze regel geeft
# de host daar een 404 — en precies die twee adressen vragen de winkels.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# De bestandsnamen dragen een hash, dus die mogen lang in de cache. index.html
# en de service worker niet: anders blijft een bezoeker op de oude versie.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
