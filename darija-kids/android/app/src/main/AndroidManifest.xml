<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      De spreekronde neemt je uitspraak op en speelt hem meteen terug. Zonder
      dit recht weigert de WebView getUserMedia en gebeurt er bij het indrukken
      van de opnameknop niets — geen foutmelding, alleen een knop die het niet
      doet. De opname verlaat het toestel niet; er is geen server.

      Trillen en de dagelijkse herinnering brengen hun eigen rechten mee vanuit
      de plugins, dus die staan hier niet.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Een tablet zonder microfoon mag de app gewoon installeren; dan valt
         alleen die ene bonusronde weg. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      SCHEDULE_EXACT_ALARM eruit, en dat is met opzet.

      `@capacitor/local-notifications` zet dit recht in zijn eigen manifest, en
      bij het samenvoegen komt het dus in onze app terecht zonder dat wij erom
      vragen. Google beperkt dat recht: het is er voor wekkers, timers en
      agenda-afspraken, en wie het aanvraagt zonder zo'n reden moet het in Play
      Console verantwoorden. Een app voor kinderen die één keer per dag een
      herinnering stuurt heeft dat niet nodig en komt er niet voor in
      aanmerking.

      Weghalen kan zonder iets kapot te maken. De plugin vraagt op Android 12 en
      later eerst `canScheduleExactAlarms()`; is dat nee, dan gebruikt hij
      `setAndAllowWhileIdle` in plaats van `setExactAndAllowWhileIdle`. De
      herinnering komt dan niet op de seconde maar rond de tijd die de ouder
      koos, en dat is precies wat er bedoeld werd. Nagelezen in
      `LocalNotificationManager.kt`, regel 357 tot 378.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
</manifest>
