<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      De spreekronde neemt je uitspraak op en speelt hem meteen terug. Zonder
      dit recht weigert de WebView getUserMedia en gebeurt er bij het indrukken
      van de opnameknop niets — geen foutmelding, alleen een knop die het niet
      doet. De opname verlaat het toestel niet; er is geen server.

      Trillen en de dagelijkse herinnering brengen hun eigen rechten mee vanuit
      de plugins, dus die staan hier niet.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Een tablet zonder microfoon mag de app gewoon installeren; dan valt
         alleen die ene bonusronde weg. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
