{
  "name": "darijaforkids",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Darijaforkids - leer Marokkaans-Arabisch (Darija) voor kinderen en jongeren",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:demo": "vite build --mode demo && node scripts/make-demo.mjs",
    "sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "assets": "node scripts/make-store-assets.mjs && @capacitor/assets generate --android",
    "soundcheck": "node scripts/soundcheck.mjs",
    "stand": "node scripts/make-stand.mjs",
    "screenshots": "node scripts/make-screenshots.mjs",
    "marketing": "node scripts/make-marketing.mjs",
    "intro": "node scripts/make-intro.mjs",
    "feedbackcheck": "node scripts/feedbackcheck.mjs",
    "historycheck": "node scripts/historycheck.mjs",
    "lettercheck": "node scripts/lettercheck.mjs",
    "sheet": "node scripts/make-sheet.mjs",
    "add-clip": "node scripts/add-clip.mjs",
    "bonuscheck": "node scripts/bonuscheck.mjs",
    "brand": "node scripts/make-brand.mjs",
    "ebook": "node scripts/make-ebook.mjs",
    "voice": "node scripts/make-voice.mjs",
    "sweep": "node scripts/sweep.mjs",
    "nieuw": "node scripts/nieuwe-gebruiker.mjs",
    "checklist": "node scripts/make-checklist.mjs",
    "opnamelijst": "node scripts/make-opnamelijst.mjs",
    "knip": "node scripts/knip-opname.mjs",
    "knipblad": "node scripts/make-knipblad.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "canvas-confetti": "^1.9.4",
    "cordova-plugin-purchase": "^13.18.0",
    "framer-motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
