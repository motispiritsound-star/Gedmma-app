# ---------------------------------------------------------------------------
# FocusFamily - voorbeeldconfiguratie / example configuration
#
# Kopieer dit bestand naar .env en vul in wat je nodig hebt.
# Copy this file to .env and fill in what you need.
#
# Niets in dit bestand is een echt geheim. De API weigert te starten in
# productie met de standaard SESSION_SECRET.
# Nothing in this file is a real secret. The API refuses to start in
# production with the default SESSION_SECRET.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL 14 of nieuwer. / PostgreSQL 14 or newer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focusfamily?schema=public

# Aparte databases voor de tests. / Separate databases for the test suites.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focusfamily_test?schema=public
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focusfamily_e2e?schema=public

# --- API -------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Ondertekent sessiecookies. Minstens 32 tekens in productie.
# Signs session cookies. At least 32 characters in production.
SESSION_SECRET=development-only-session-secret-change-me

# Komma-gescheiden lijst van origins die met cookies mogen praten.
# Comma-separated list of origins allowed to send credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
# COOKIE_DOMAIN=.focusfamily.example

# --- Schermtijd / screen time ---------------------------------------------
# 1 = altijd de mock-adapter gebruiken. Dit is de standaard, en het enige wat
#     werkt zonder Apple- of Google-rechten. Zie NATIVE_CAPABILITIES.md.
# 1 = always use the mock adapter. This is the default, and the only thing that
#     works without Apple or Google entitlements. See NATIVE_CAPABILITIES.md.
FOCUSFAMILY_USE_MOCK=1

# --- Betalen / billing -----------------------------------------------------
# mock (standaard) of stripe_test. stripe_test eist een sleutel; zonder sleutel
# weigert de API te starten in plaats van een betaling te faken.
# mock (default) or stripe_test. stripe_test requires a key; without one the
# API refuses to start rather than faking a payment.
BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_FAMILY_PREMIUM=price_...

# --- Optionele AI-hulp / optional AI helper --------------------------------
# 0 = uit. Dit is de standaard en de aanbevolen instelling. Aanzetten vraagt
#     bovendien per gezin om een ai.assistant-toestemming.
# 0 = off. This is the default and the recommended setting. Turning it on also
#     requires an ai.assistant consent record per family.
AI_ADVISOR_ENABLED=0

# --- Web -------------------------------------------------------------------
FOCUSFAMILY_API_URL=http://127.0.0.1:4000
FOCUSFAMILY_WEB_ORIGIN=http://localhost:3000

# --- Mobiel / mobile -------------------------------------------------------
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_USE_MOCK_SCREENTIME=1

# --- Tests -----------------------------------------------------------------
# Alleen nodig als het systeem een andere Chromium heeft dan Playwright verwacht.
# Only needed when the system ships a different Chromium than Playwright expects.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
