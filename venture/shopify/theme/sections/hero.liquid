{%- comment -%}
  Hero. Static, one message, one call to action.

  No slider and no auto-rotation: static heroes outperform sliders, and rotation
  creates hesitation about what the first fold means. A single CTA prevents
  choice paralysis at the highest-attention point on the site.
{%- endcomment -%}
<section class="hero">
  {%- if section.settings.image -%}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '100vw',
          alt: section.settings.image_alt | escape,
          fetchpriority: 'high',
          loading: 'eager'
      }}
    </div>
  {%- endif -%}

  <div class="page-width hero__content">
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
      <a class="button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "This is the LCP element. Keep it under 200 KB." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Padel kit built for weather" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "info": "Name the customer and the outcome." },
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
