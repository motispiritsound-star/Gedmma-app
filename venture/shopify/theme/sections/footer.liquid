{%- comment -%}
  Footer.

  The legal block is not decoration. EU distance-selling information duties
  require the trader's identity and contact details to be available, and a Dutch
  trader must show KvK and btw numbers. The response-time commitment is a trust
  signal and should only state what support can actually meet.
{%- endcomment -%}
<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'contact' -%}
          <div {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <p class="text-s">{{ block.settings.body }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div>
        <h2 class="footer__heading">{{ 'localization.heading' | t }}</h2>
        {% render 'market-selector' %}
      </div>
    </div>

    <div class="footer__legal">
      <p class="text-s">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {%- if settings.company_legal_name != blank %} {{ settings.company_legal_name }}.{% endif -%}
        {%- if settings.kvk_number != blank %} KvK {{ settings.kvk_number }}.{% endif -%}
        {%- if settings.vat_number != blank %} btw {{ settings.vat_number }}.{% endif -%}
      </p>
      {%- if settings.company_address != blank -%}
        <p class="text-s">{{ settings.company_address }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Body", "info": "Include a response-time commitment you can actually meet." }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
