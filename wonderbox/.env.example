# ---------------------------------------------------------------------------
# WonderBox environment
#
# Copy this file to apps/web/.env before running anything:
#     cp .env.example apps/web/.env       (or: npm run env:init)
#
# Every value below has a working local default. The app runs end to end with
# mock payment, shipping, storage and AI providers — no external account needed.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Any PostgreSQL 14+ instance. `docker compose up -d db` starts one on 5432.
DATABASE_URL="postgresql://wonderbox:wonderbox@127.0.0.1:5432/wonderbox"
# Used by `npm run test` — it is wiped between runs, so never point it at dev data.
TEST_DATABASE_URL="postgresql://wonderbox:wonderbox@127.0.0.1:5432/wonderbox_test"

# --- Application -----------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"
# Default locale for anonymous visitors. Supported: nl, en.
DEFAULT_LOCALE="nl"

# --- Sessions and secrets --------------------------------------------------
# 32+ random bytes, base64. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The app refuses to boot in production with the development placeholder.
SESSION_SECRET="dev-only-insecure-session-secret-change-me-0000000000"
# Pepper mixed into activation-code hashes. Rotating it invalidates printed codes.
ACTIVATION_CODE_PEPPER="dev-only-activation-pepper-change-me"
SESSION_TTL_HOURS="720"

# --- Payments --------------------------------------------------------------
# "mock" keeps everything in-process. "stripe" uses the real API in test mode.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Shared secret the mock provider signs its webhooks with.
MOCK_PAYMENT_WEBHOOK_SECRET="dev-mock-payment-secret"

# --- Fulfilment / shipping -------------------------------------------------
# "mock" simulates label creation and delivery transitions locally.
SHIPPING_PROVIDER="mock"
SHIPPING_API_KEY=""
SHIPPING_WEBHOOK_SECRET="dev-mock-shipping-secret"
SHIPPING_ORIGIN_COUNTRY="NL"
SHIPPING_FLAT_RATE_CENTS="495"

# --- Object storage (audio, invoices, labels) ------------------------------
# "local" writes to .storage/ and serves bytes only through signed app routes.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".storage"
STORAGE_SIGNING_SECRET="dev-only-storage-signing-secret"
STORAGE_URL_TTL_SECONDS="300"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- AI drafting (editors only; never child-facing) ------------------------
# Generated text is always a DRAFT and can never reach a child without a human
# approval. "mock" returns canned drafts so the studio works offline.
AI_DRAFT_PROVIDER="mock"
AI_DRAFT_API_KEY=""
AI_DRAFT_MODEL="claude-sonnet-5"

# --- Speech to text (off by default) ---------------------------------------
# Even when enabled, a family must give explicit parental consent per child,
# and audio is discarded immediately after transcription.
SPEECH_TO_TEXT_ENABLED="false"
SPEECH_TO_TEXT_PROVIDER="mock"
SPEECH_TO_TEXT_RETENTION_MINUTES="0"

# --- Retention (days) ------------------------------------------------------
PROGRESS_EVENT_RETENTION_DAYS="400"
AUDIT_LOG_RETENTION_DAYS="730"
