# ---------------------------------------------------------------------------
# SkillPass — environment configuration
# Copy to .env and adjust. Every external service has a working mock default,
# so the application runs end-to-end with NO third-party credentials.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ random bytes, base64 or hex. Generate: openssl rand -hex 32
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
# Signing key for private media URLs. Generate: openssl rand -hex 32
MEDIA_SIGNING_SECRET=dev-only-media-secret-change-me-0123456789abcdef

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://skillpass:skillpass@localhost:5432/skillpass?schema=public
# Used by `npm run test` (integration tests truncate this database).
TEST_DATABASE_URL=postgresql://skillpass:skillpass@localhost:5432/skillpass_test?schema=public

# --- Launch region ----------------------------------------------------------
DEFAULT_CITY_SLUG=utrecht
DEFAULT_LOCALE=nl
DEFAULT_CURRENCY=EUR

# --- Payments ---------------------------------------------------------------
# mock | stripe   (mock is fully functional offline, including signed webhooks)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
# Only needed when PAYMENT_PROVIDER=stripe. Use TEST-mode keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# mock (writes to ./storage/outbox + the notification centre) | smtp
EMAIL_PROVIDER=mock
EMAIL_FROM="SkillPass <no-reply@skillpass.local>"
SMTP_URL=

# --- Object storage ---------------------------------------------------------
# local (./storage/media, served through signed URLs) | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/media
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# --- Maps / geocoding -------------------------------------------------------
# mock (offline gazetteer + haversine) | osm (Nominatim) | mapbox
GEO_PROVIDER=mock
MAPBOX_TOKEN=
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Safety limits ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Days a cancelled/blocked account is retained before hard erasure.
DATA_RETENTION_DAYS=365
