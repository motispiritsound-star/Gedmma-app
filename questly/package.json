{
  "name": "questly",
  "version": "0.1.0",
  "private": true,
  "description": "Questly - offline adventures and educational missions for families.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "retention:purge": "tsx scripts/purge-retention.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.6.0",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "dotenv": "^17.4.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prisma": "7.10.0",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}