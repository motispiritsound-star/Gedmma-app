DATABASE_URL="postgresql://questly:questly@127.0.0.1:5432/questly_e2e?schema=public"
SESSION_SECRET="e2e-session-secret-0123456789abcdefghijklmnop"
MEDIA_SECRET="e2e-media-secret-0123456789abcdefghijklmnopqr"
APP_URL="http://localhost:3100"
MEDIA_DRIVER="local"
MEDIA_LOCAL_DIR="./.data/media-e2e"
PAYMENT_PROVIDER="mock"
LOG_LEVEL="error"

# End-to-end only. The suite runs a production build, so the verification link
# has to be shown on screen for the registration journey to be testable.
AUTH_SHOW_VERIFICATION_LINK="true"
EMAIL_DRIVER="log"

# The whole suite drives one IP; the real limits are covered by unit tests.
RATE_LIMIT_AUTH_MAX="500"
RATE_LIMIT_UPLOAD_MAX="500"
