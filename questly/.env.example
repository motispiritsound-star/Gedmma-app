# ---------------------------------------------------------------------------
# Questly environment configuration
# Copy to `.env` and adjust. Every variable is validated at boot by src/env.ts;
# the app refuses to start with an invalid configuration.
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string.
DATABASE_URL="postgresql://questly:questly@localhost:5432/questly?schema=public"

# Required in production, optional in development (a dev-only fallback is used).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Public base URL, used for links in e-mails and for absolute redirects.
APP_URL="http://localhost:3000"

# nl | en - the locale used when a visitor has expressed no preference.
DEFAULT_LOCALE="nl"

# --- Media storage ---------------------------------------------------------
# local | s3 . The MVP ships the `local` adapter; `s3` is an interface stub.
MEDIA_DRIVER="local"
MEDIA_LOCAL_DIR="./.data/media"
# Minutes a signed media URL stays valid.
MEDIA_URL_TTL_MINUTES="10"
MEDIA_MAX_UPLOAD_BYTES="8388608"

# --- Payments --------------------------------------------------------------
# mock | stripe . With `mock` the app runs end to end without any Stripe account.
PAYMENT_DRIVER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# --- E-mail ----------------------------------------------------------------
# console | noop . `console` writes verification e-mails to the structured log.
EMAIL_DRIVER="console"
EMAIL_FROM="hello@questly.example"

# --- AI (optional) ---------------------------------------------------------
# none | anthropic . Recommendations work fully without this; the AI provider
# only re-ranks an already-valid deterministic result set.
AI_DRIVER="none"
ANTHROPIC_API_KEY=""

# --- Retention -------------------------------------------------------------
# Days a deletion request is held before the purge job removes the data.
RETENTION_DELETION_GRACE_DAYS="30"
# Days audit log entries are kept.
RETENTION_AUDIT_LOG_DAYS="365"

# --- Misc ------------------------------------------------------------------
LOG_LEVEL="info"
# Set to "true" to allow the seed script to run. Never enable in production.
ALLOW_SEED="true"
