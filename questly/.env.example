# ---------------------------------------------------------------------------
# Questly - copy this file to .env and fill in the values.
# Nothing here needs an external service: with these defaults the application
# runs completely locally, with a mock payment provider and no AI provider.
# ---------------------------------------------------------------------------

# Required -------------------------------------------------------------------

# PostgreSQL connection string. `docker compose up -d` starts a matching server.
DATABASE_URL="postgresql://questly:questly@127.0.0.1:5432/questly?schema=public"

# Two independent secrets, at least 32 characters each.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
MEDIA_SECRET="change-me-to-a-different-random-string-of-32-plus-chars"

# Public base URL. Used for links in emails and payment redirects.
APP_URL="http://localhost:3000"

# Optional -------------------------------------------------------------------

NODE_ENV="development"
LOG_LEVEL="info"                     # debug | info | warn | error

# Sessions and signed media links
SESSION_TTL_HOURS="336"              # 14 days
MEDIA_URL_TTL_SECONDS="300"          # signed evidence links expire after 5 minutes

# Private media storage
MEDIA_DRIVER="local"                 # local | s3  (s3 is an interface only, see SECURITY_AND_PRIVACY.md)
MEDIA_LOCAL_DIR="./.data/media"
MEDIA_MAX_BYTES="8388608"            # 8 MB per upload
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Payments. With "mock" no credentials are needed and no money can move.
PAYMENT_PROVIDER="mock"              # mock | stripe
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_FAMILY_PREMIUM="price_..."

# Email. No transactional provider is implemented; "log" writes the message
# (including one-time links) to the structured log. Defaults to "none" in
# production, "log" everywhere else.
# EMAIL_DRIVER="log"                 # log | none

# Development convenience: shows the email verification link on screen instead
# of only sending it. Defaults to off in production; never enable it there.
# AUTH_SHOW_VERIFICATION_LINK="false"

# Recommendations. The deterministic engine is always used; this only selects an
# optional enhancement layer, which is not implemented in the MVP.
AI_PROVIDER="none"                   # none | anthropic
# ANTHROPIC_API_KEY=

# Retention
RETENTION_DELETION_GRACE_DAYS="30"   # days between a deletion request and the purge
RETENTION_EVIDENCE_DAYS="0"          # 0 = keep evidence until the family deletes it
RETENTION_AUDIT_LOG_DAYS="365"

# Rate limiting (in-process; see SECURITY_AND_PRIVACY.md for the multi-instance note)
RATE_LIMIT_AUTH_MAX="10"
RATE_LIMIT_AUTH_WINDOW_SECONDS="300"
RATE_LIMIT_UPLOAD_MAX="20"
RATE_LIMIT_UPLOAD_WINDOW_SECONDS="600"
