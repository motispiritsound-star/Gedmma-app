{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/core/**/*.ts",
    "test/**/*.ts"
  ]
}