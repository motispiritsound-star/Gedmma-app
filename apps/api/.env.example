# Khidma API configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL="postgresql://khidma:khidma@localhost:5432/khidma?schema=public"

# Signing keys. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters-long"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=60d

# SMS provider for one-time codes. `log` prints the code to the server log,
# which is what local development and the seeded demo accounts use.
SMS_PROVIDER=log
SMS_SENDER_ID=Khidma
SMS_API_KEY=

# Payment gateway. `mock` settles subscriptions immediately without a redirect.
PAYMENT_PROVIDER=mock
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate

# Comma-separated list, or * in development.
CORS_ORIGINS=*
