# Buurklus API configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL="postgresql://buurklus:buurklus@localhost:5432/buurklus?schema=public"

# Signing keys. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters-long"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=60d

PUBLIC_APP_URL=https://buurklus.nl
PUBLIC_API_URL=http://localhost:4000

# SMS provider for one-time codes. `log` prints the code to the server log,
# which is what local development and the seeded demo accounts use.
# For production: MessageBird, CM.com and Spryng all fit the `http` adapter.
SMS_PROVIDER=log
SMS_SENDER_ID=Buurklus
SMS_API_KEY=
SMS_ENDPOINT=

# Payments. `mock` settles subscriptions immediately without a redirect.
# `mollie` covers iDEAL and SEPA direct debit.
PAYMENT_PROVIDER=mock
MOLLIE_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Comma-separated list, or * in development.
CORS_ORIGINS=*
