# Optioneel: KVK API-key (https://developers.kvk.nl) voor de kvk-bron en voor
# "webscan verrijken" (rechtsvorm en KVK-nummer ophalen bij een lead).
KVK_API_KEY=
# Alleen nodig als je de testomgeving van de KVK gebruikt in plaats van de echte.
# KVK_API_URL=https://api.kvk.nl/test/api

# Optioneel: overschrijf de standaardinstellingen.
WEBSCAN_DB=./data/webscan.db
WEBSCAN_CONCURRENCY=6
WEBSCAN_TIMEOUT_MS=15000
WEBSCAN_USER_AGENT=WebscanNL/0.1 (+website-kwaliteitsscan; contact: jouw@email.nl)
