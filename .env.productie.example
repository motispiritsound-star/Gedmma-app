# Instellingen voor een test- of productieomgeving.
#
# Kopieer dit bestand op de server naar .env, naast docker-compose.prod.yml, en
# vul het in. Zet het nooit in git: het staat daarom in .gitignore.
#
# De geheimen genereer je één keer met:  npm run geheimen
#
# Let op: PASSWORD_PEPPER en DATA_ENCRYPTION_KEY wijzigen ná ingebruikname maakt
# bestaande wachtwoorden en versleutelde gegevens onbruikbaar.

# --- Waar draait hij ---------------------------------------------------------

# Het domein dat naar deze server wijst. Caddy vraagt hiervoor een certificaat
# aan; zonder werkend DNS mislukt dat.
DOMEIN=test.jouwdomein.nl

# Adres waarop Let's Encrypt je bereikt als er iets is met het certificaat.
BEHEER_EMAIL=jij@jouwdomein.nl

# --- Geheimen (npm run geheimen) ---------------------------------------------

DB_WACHTWOORD=
DB_APP_WACHTWOORD=
PASSWORD_PEPPER=
DATA_ENCRYPTION_KEY=

# --- Wat voor omgeving is dit ------------------------------------------------

# Zichtbare balk boven in de applicatie. Leeg laten op een echte
# productieomgeving; gevuld op alles wat een proef is.
OMGEVING_LABEL=Testomgeving

# Mag iedereen die het adres kent een account aanmaken?
# Op een publiek bereikbare omgeving hoort dit op "nee": dan komt er alleen
# iemand binnen die je zelf uitnodigt. Zet hem tijdelijk op "ja" om het eerste
# account aan te maken, en daarna weer terug.
REGISTRATIE_OPEN=nee

# --- E-mail ------------------------------------------------------------------

# "logboek" schrijft uitnodigingen en facturen naar de log in plaats van ze te
# versturen; genoeg voor een proefopstelling. Voor echte e-mail: "smtp".
#
# Let op: met "logboek" komt er niets aan bij je klant, terwijl het scherm wel
# zegt dat de factuur verstuurd is. Zodra je iemand anders dan jezelf iets
# stuurt, hoort dit op "smtp" te staan.
MAIL_DRIVER=logboek
MAIL_FROM=geen-antwoord@jouwdomein.nl

# Alleen nodig bij MAIL_DRIVER=smtp. Zonder deze regel start de API niet: beter
# meteen stuk dan maandenlang facturen versturen die nergens aankomen.
# Poort 465 is versleuteld vanaf de eerste byte (smtps), 587 begint onversleuteld
# en schakelt over met STARTTLS (smtp). Neem 465 als je provider het aanbiedt.
# SMTP_URL=smtps://gebruiker:wachtwoord@smtp.jouwprovider.nl:465
